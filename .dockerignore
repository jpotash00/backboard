# Keep the build context (and image) lean: only the Python packages the API needs.
.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.eggs
build
dist
.pytest_cache
.vscode
.idea
.DS_Store

# Local secrets and data -- never bake into an image.
.env
runs
scratch_runs

# Node / SDK build artifacts -- shipped to npm separately, not in the API image. The demo/ page
# IS served by the engine (GET /demo), so it is deliberately NOT ignored; it's a tiny self-contained
# HTML file that pulls the SDK from a CDN (no bundled JS), so shipping it keeps the image lean.
sdk/node_modules
node_modules
demo/*.md
# NOTE: sdk/dist is intentionally NOT ignored -- the engine serves it at /demo/sdk so the demo page
# imports the SDK same-origin (no CDN, no version pin). It's the built ESM only, kept small.

# Tests and the brief aren't needed at runtime.
tests
offboard-build-brief.md
